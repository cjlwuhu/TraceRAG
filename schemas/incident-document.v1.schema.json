{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyrag.local/schemas/incident-document.v1.schema.json",
  "title": "EasyRAG IncidentDocument v1",
  "description": "A retrieval-safe incident record produced from one or more RCA runs.",
  "type": "object",
  "additionalProperties": false,
    "required": [
    "schema_version",
    "incident_id",
    "system",
    "lifecycle",
    "detection",
    "observations",
    "rca_runs",
    "retrieval_text",
    "source_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "incident_id": { "type": "string", "pattern": "^inc-[0-9]{10}-[a-f0-9]{12}$" },
    "system": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["active", "resolved"] },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_unix", "timestamp_utc", "source"],
      "properties": {
        "timestamp_unix": { "type": "integer", "minimum": 0 },
        "timestamp_utc": { "type": "string", "format": "date-time" },
        "source": { "enum": ["benchmark_annotation", "anomaly_detector", "operator"] },
        "window_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspected_services", "candidate_metrics"],
      "properties": {
        "suspected_services": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "candidate_metrics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "rca_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "candidates"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "runtime_seconds": { "type": "number", "minimum": 0 },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rank", "metric"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1 },
                "metric": { "type": "string", "minLength": 1 },
                "service": { "type": "string", "minLength": 1 },
                "signal": { "type": "string", "minLength": 1 },
                "score": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "retrieval_text": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "method", "sha256"],
        "properties": {
          "source_type": { "const": "rca_result" },
          "method": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
